tab_bar_glass_section = "Tab bar";
tab_bar_glass = "Liquid Glass on the tabs";
tab_bar_glass_description = "Puts the system's Liquid Glass (iOS 26 and up, falling back to a material) behind the four tabs — Home, Search, Your Library and Create. The four tabs are also pulled slightly towards the centre so the glass hugs them instead of stretching across the whole bar. The icons stay above the glass and keep working. Switching it off removes everything again.";
library_large_title = "Apple Music style header";
library_large_title_description = "Changes Spotify's own library header: the title goes left-aligned with a little more breathing room, and the grey fade Spotify draws at the top edge is taken away. Switching it off puts both back.";
now_playing_shell_description = "Draws the now playing page ourselves instead of layering into Spotify's views: the whole page takes the cover's colour, and the title and artist are ours, so Spotify's own fading header can no longer cover them. Spotify's controls (transport, slider, menu) stay where they are and keep working. Switching it off restores the page, including Spotify's own header.";
music_style_nowplaying = "Cover-tinted background + big title";
music_style_nowplaying_description = "The first sample of the Apple Music style: the page background takes the cover's own colour, and the song title and artist sit at the top. It only ADDS those two things and hides nothing of Spotify's own player, so switching it off restores the page exactly. It applies the next time the now playing page lays out — no restart.";
tab_bar_hide_labels = "Hide tab labels";

mini_bar_glass_section = "Mini player";
mini_bar_glass = "Liquid Glass on the mini player";
mini_bar_glass_description = "Gives the mini player the same Liquid Glass capsule as the tab bar: **same width, same 60 pt height, same corner radius, same material**, keeping the small gap between the two. The width follows the tab bar's capsule (360 pt on this device), so the mini player's own content (artwork, title, buttons, progress line) is scaled down uniformly to fit inside (~86%). While it is on, the solid cover-coloured background is cleared — including right after it appears or a track changes, when Spotify writes it back; switching it off restores everything — glass removed, content back to its original size, background and clipping restored.";

