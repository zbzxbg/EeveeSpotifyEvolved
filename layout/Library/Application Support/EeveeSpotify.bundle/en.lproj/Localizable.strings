/* MARK: Blocked artists */
blocked_artists_title = "Blocked artists";
blocked_artists_enabled = "Skip blocked artists automatically";
blocked_artists_description = "A track by a blocked artist is skipped to the next one as it starts, wherever it comes from: your playlists, someone else's, radio or a share link. This only skips playback — nothing is removed or hidden in Spotify (playlists, search and Home are untouched). Names are matched ignoring case, and as substrings: blocking MIMI also matches MIMI, Sumire, so an artist with a similar name is caught too. Only the first few seconds of a track are checked, and after 5 skips in a row it stops, so a queue made entirely of blocked artists will not flip through forever.";
